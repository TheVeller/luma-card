# Copy to .env and fill in. .env is gitignored — never commit real values.
# Client-exposed (VITE_*) values are inlined into the browser bundle by design.

# Supabase (publishable/anon — safe to expose client-side)
SUPABASE_PROJECT_ID=""
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Server-only secrets — inject at the Cloudflare/Lovable runtime, do NOT put real
# values here or in .env. Listed for reference only:
#   SUPABASE_SECRET_KEY        # preferred current Supabase server key (sb_secret_...)
#   SUPABASE_SERVICE_ROLE_KEY   # service-role, bypasses RLS
#   APP_ENCRYPTION_KEY          # AES-256-GCM key for encrypting provider tokens at rest
#   FIRECRAWL_API_KEY           # public organizer/group discovery fallbacks
#   MEETUP_CLIENT_ID            # required only to refresh Meetup OAuth tokens
#   MEETUP_CLIENT_SECRET        # required only to refresh Meetup OAuth tokens
#   VERCEL_AI_GATEWAY_API_KEY   # AI gateway (badge chat)
#   LOVABLE_API_KEY             # Lovable image gateway
