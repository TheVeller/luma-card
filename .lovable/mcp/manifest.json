    "issuer": "https://agbghexkyxqjbkifycfz.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "luma-badge-studio-mcp",
      "version": "0.1.0",
      "title": "Luma Badge Studio"
