.vinxi
.tanstack/**
.nitro
*.local

# Env — .env holds the publishable Supabase keys the build inlines (VITE_*), so
# it MUST stay tracked: Lovable/Vite read it at build time to bake VITE_* into
# the client bundle. These keys are public by design (RLS is the boundary).
# Only ignore local, potentially-secret overrides.
.env.local
.env.*.local

# Package managers (this project uses bun — bun.lock is the source of truth)
package-lock.json
yarn.lock
pnpm-lock.yaml

# Wrangler / Cloudflare
.wrangler/
.dev.vars

